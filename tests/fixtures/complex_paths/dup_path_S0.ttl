@prefix ex: <http://example.org/cpath#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property [
    sh:path ( ex:address ex:code ) ;
    sh:minCount 1 ;
    sh:name "primary"
  ] ;
  sh:property [
    sh:path ( ex:address ex:code ) ;
    sh:maxCount 0 ;
    sh:name "secondary"
  ] .
