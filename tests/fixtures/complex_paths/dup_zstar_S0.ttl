@prefix ex: <http://example.org/cpath#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property [
    sh:path [ sh:zeroOrMorePath ex:knows ] ;
    sh:minCount 2
  ] ;
  sh:property [
    sh:path [ sh:zeroOrMorePath ex:knows ] ;
    sh:minCount 2
  ] .
