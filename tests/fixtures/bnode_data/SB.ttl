@prefix ex: <http://example.org/ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ItemShape
  a sh:NodeShape ;
  sh:targetClass ex:Item ;
  sh:property ex:ItemShape-label .

ex:ItemShape-label
  a sh:PropertyShape ;
  sh:path ex:label ;
  sh:datatype xsd:string ;
  sh:maxCount 2 .
