@prefix ex: <http://example.org/sparql#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:DistShape a sh:NodeShape ;
  sh:targetClass ex:Distribution ;
  sh:sparql [
    sh:select """
      SELECT $this WHERE {
        FILTER NOT EXISTS { $this <http://example.org/sparql#rights> ?r }
      }
    """
  ] .
